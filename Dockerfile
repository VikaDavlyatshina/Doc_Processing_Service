# ============================================================================
# DOCKERFILE ДЛЯ DOCFLOW (Сервис обработки документов)
# ============================================================================

# 1. БАЗОВЫЙ ОБРАЗ
# ----------------------------------------------------------------------------
# Берём официальный образ Python 3.13 (облегчённая версия slim)
# slim — это минимальный образ без лишних пакетов, экономит место
FROM python:3.13-slim


# 2. ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ
# ----------------------------------------------------------------------------
# Отключаем создание .pyc файлов (экономит место и ускоряет запуск)
ENV PYTHONDONTWRITEBYTECODE=1

# Отключаем буферизацию вывода (логи видно сразу, не дожидаясь накопления)
ENV PYTHONUNBUFFERED=1


# 3. РАБОЧАЯ ПАПКА
# ----------------------------------------------------------------------------
# Создаём и переходим в папку /app внутри контейнера
# Все следующие команды будут выполняться в этой папке
WORKDIR /app


# 4. СИСТЕМНЫЕ ЗАВИСИМОСТИ
# ----------------------------------------------------------------------------
# Обновляем список пакетов и устанавливаем нужные библиотеки
# gcc — компилятор, нужен для сборки некоторых Python пакетов
# libpq-dev — нужен для работы с PostgreSQL
# libmagic1 — нужен для python-magic (определение типа файлов)
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    libmagic1 \
    && rm -rf /var/lib/apt/lists/*


# 5. УСТАНОВКА POETRY
# ----------------------------------------------------------------------------
# Poetry — менеджер зависимостей (альтернатива pip)
# --no-cache-dir — не сохранять кеш, экономит место
RUN pip install --no-cache-dir poetry


# 6. КОПИРОВАНИЕ ЗАВИСИМОСТЕЙ (кешируется)
# ----------------------------------------------------------------------------
# Копируем файлы с описанием зависимостей (меняются редко)
# poetry.lock — фиксирует точные версии всех пакетов
# pyproject.toml — описывает зависимости проекта
COPY pyproject.toml poetry.lock ./


# 7. УСТАНОВКА ЗАВИСИМОСТЕЙ PYTHON
# ----------------------------------------------------------------------------
# virtualenvs.create false — не создавать виртуальное окружение (используем системный Python)
# --no-interaction — не задавать вопросы при установке
# --no-ansi — отключает цветной вывод (чище логи)
RUN poetry config virtualenvs.create false \
    && poetry install --no-interaction --no-ansi


# 8. КОПИРОВАНИЕ КОДА ПРОЕКТА (кеш сбрасывается)
# ----------------------------------------------------------------------------
# Копируем весь код проекта в контейнер
# .dockerignore исключает ненужные файлы
COPY . .


# 9. СОЗДАНИЕ ОГРАНИЧЕННОГО ПОЛЬЗОВАТЕЛЯ (безопасность)
# ----------------------------------------------------------------------------
# Создаём пользователя без прав root и даём права на папку /app
RUN adduser --disabled-password --gecos '' appuser \
    && chown -R appuser:appuser /app

# Переключаемся на ограниченного пользователя
USER appuser


# 10. ПОРТ
# ----------------------------------------------------------------------------
# Указываем порт, который будет использовать приложение
EXPOSE 8000


# 11. КОМАНДА ЗАПУСКА
# ----------------------------------------------------------------------------
# gunicorn — запускает WSGI сервер
# --bind 0.0.0.0:8000 — слушаем все интерфейсы на порту 8000
# --workers 1 — один воркер
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "1"]