# ============================================================================
# DOCKERFILE ДЛЯ DOCFLOW (Сервис обработки документов)
# ============================================================================

# 1. БАЗОВЫЙ ОБРАЗ
# ----------------------------------------------------------------------------
FROM python:3.13-slim

# 2. ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ
# ----------------------------------------------------------------------------
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# 3. РАБОЧАЯ ПАПКА
# ----------------------------------------------------------------------------
WORKDIR /app

# 4. СИСТЕМНЫЕ ЗАВИСИМОСТИ (gcc, postgresql-client, libmagic)
# ----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    libmagic1 \
    && rm -rf /var/lib/apt/lists/*

# 5. УСТАНОВКА POETRY
# ----------------------------------------------------------------------------
RUN pip install --no-cache-dir poetry

# 6. КОПИРОВАНИЕ ЗАВИСИМОСТЕЙ (Для кеширования слоев Docker)
# ----------------------------------------------------------------------------
COPY pyproject.toml poetry.lock ./

# 7. УСТАНОВКА ЗАВИСИМОСТЕЙ PYTHON (В системное окружение контейнера)
# ----------------------------------------------------------------------------
RUN poetry config virtualenvs.create false \
    && poetry install --no-interaction --no-ansi --no-root

# 8. КОПИРОВАНИЕ КОДА ПРОЕКТА
# ----------------------------------------------------------------------------
COPY . .

# 9. СОЗДАНИЕ ПАПОК И НАСТРОЙКА ПРАВ ДОСТУПА
# ----------------------------------------------------------------------------
# Создаем пользователя appuser заранее
RUN adduser --disabled-password --gecos '' appuser

# Создаем папки для статики и медиа
RUN mkdir -p /app/staticfiles /app/media

# Даем полные права владельца пользователю appuser на ВСЮ папку /app
# Явно разрешаем запись в статику и медиа (это защитит от Permission Denied в Docker Volumes)
RUN chown -R appuser:appuser /app \
    && chmod -R 775 /app/staticfiles /app/media

# Переключаемся на безопасного ограниченного пользователя
USER appuser

# 11. ПОРТ ВНУТРИ КОНТЕЙНЕРА
# ----------------------------------------------------------------------------
EXPOSE 8000

# 12. БАЗОВАЯ КОМАНДА ЗАПУСКА
# ----------------------------------------------------------------------------
# На сервере эта строка заменится на команду с миграциями из docker-compose.yml
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000"]