[run]
source = .
omit =
    */migrations/*
    */tests/*
    */admin.py
    */apps.py
    */management/*
    */asgi.py
    */wsgi.py
    manage.py
    config/settings.py
    config/urls.py
    config/wsgi.py
    config/asgi.py
    config/celery.py
    */__init__.py

[report]
exclude_lines =
    pragma: no cover
    if settings.DEBUG
    if __name__ == .__main__.